# Local extraction works without an API key. Structured inputs never call an LLM.
ENABLE_OPENROUTER=false
OPENROUTER_API_KEY=
# Choose a model that supports JSON schema, plus vision when using image inputs.
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional absolute path. Default: ./data
# LEDGERFLOW_DATA_DIR=/absolute/path/to/ledgerflow-data
# Hosting only: Render supplies its own HTTPS origin automatically.
# LEDGERFLOW_PUBLIC_ORIGIN=https://your-service.onrender.com
# LEDGERFLOW_AUTH_USERNAME=reviewer
# LEDGERFLOW_AUTH_PASSWORD=use-a-random-secret-of-at-least-20-characters
